-- 9.6 SILENT AIM
-- ==========================================
local SA_ORIGIN_RADIUS = 16
local SA_HEAD_RADIUS = 6
local SA_MIN_RAY_DIST = 50
local SA_MAX_RAY_DIST = 5000

local silentTargetPlayer = nil
local silentTargetPart = nil
local saRunToken = true
local saHooksInstalled = false

local function getSilentAimPosition()
        local part = silentTargetPart
        if part and part.Parent and part:IsDescendantOf(Workspace) then
                local pos = part.Position
                if isFiniteVec3(pos) then return pos end
        end
        return nil
end

local SA_DIR_GATE = 0.72
local weaponOkCache = false
local weaponOkAt = 0
local saVisPlayer = nil
local saVisOk = false
local saVisAt = 0

local function computeRedirect(origin, direction)
        if not saHooksInstalled or internalRayActive or not saRunToken or not State.SilentAim then return nil end
        local now = os.clock()
        if now - weaponOkAt > 0.1 then
                weaponOkAt = now
                weaponOkCache = hasActiveWeapon()
        end
        if not weaponOkCache then return nil end
        local aimPos = getSilentAimPosition()
        if not aimPos then return nil end
        if not isFiniteVec3(origin) or not isFiniteVec3(direction) then return nil end
        local mag = direction.Magnitude
        if not (mag >= SA_MIN_RAY_DIST and mag <= SA_MAX_RAY_DIST) then return nil end

        local toAim = aimPos - origin
        local toAimUnit = safeUnit(toAim)
        local dirUnit = safeUnit(direction)
        if not toAimUnit or not dirUnit then return nil end
        if toAimUnit:Dot(dirUnit) < SA_DIR_GATE then return nil end

        local camera = getCamera()
        if not camera then return nil end
        local nearCam = (origin - camera.CFrame.Position).Magnitude <= SA_ORIGIN_RADIUS
        if not nearCam then
                local myChar = LocalPlayer and LocalPlayer.Character
                local anchor = myChar and (myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart"))
                if not (anchor and (origin - anchor.Position).Magnitude <= SA_HEAD_RADIUS) then
                        return nil
                end
        end

        if State.SilentAimWallCheck ~= false then
                local tp = silentTargetPlayer
                if not (tp and tp.Parent) then return nil end
                if tp ~= saVisPlayer or now - saVisAt > 0.06 then
                        saVisPlayer = tp
                        saVisAt = now
                        saVisOk = (tp.Character ~= nil)
                                and VisibilityService:CheckVisibility(tp.Character, 1, silentTargetPart) == true
                end
                if not saVisOk then return nil end
        end

        return toAimUnit * mag
end

local function saRayChannelActive()
        local mode = State.SilentAimMode
        return mode == "Auto" or mode == "Raycast"
end

local function saCamChannelActive()
        local mode = State.SilentAimMode
        return mode == "Auto" or mode == "CamRay"
end

local function saMouseChannelActive()
        local mode = State.SilentAimMode
        return mode == "Auto" or mode == "Mouse Hit"
end

local mouseRef = nil
if LocalPlayer then
        local okM, m = pcall(function() return LocalPlayer:GetMouse() end)
        if okM then mouseRef = m end
end
local oldIndexHook = nil
local mouseHookInstalled = false

function saSetMouseHookActive(active)
        if not silentAimSupported or not mouseRef then return end
        if active and not mouseHookInstalled
                and type(hookmetamethod) == "function" and type(newcclosure) == "function" then
                local ok, old = pcall(hookmetamethod, game, "__index", newcclosure(function(t, k)
                        if t == mouseRef and not internalRayActive and saRunToken
                                and State.SilentAim and saMouseChannelActive() then
                                if k == "Hit" then
                                        local aimPos = getSilentAimPosition()
                                        if aimPos then
                                                if State.SilentAimWallCheck ~= false then
                                                        local tp = silentTargetPlayer
                                                        if (tp and tp.Parent)
                                                                and VisibilityService:CheckVisibility(tp.Character, 1, silentTargetPart) then
                                                                return CFrame.new(aimPos)
                                                        end
                                                else
                                                        return CFrame.new(aimPos)
                                                end
                                        end
                                elseif k == "Target" then
                                        if silentTargetPart and silentTargetPart.Parent then
                                                return silentTargetPart
                                        end
                                end
                        end
                        return oldIndexHook(t, k)
                end))
                if ok and old then
                        oldIndexHook = old
                        mouseHookInstalled = true
                end
        elseif not active and mouseHookInstalled and oldIndexHook
                and type(hookmetamethod) == "function" then
                if pcall(hookmetamethod, game, "__index", oldIndexHook) then
                        mouseHookInstalled = false
                        oldIndexHook = nil
                end
        end
end

local namecallHooked = false
local oldNamecall = nil
local origRaycastFn = nil

function saUninstallHooks()
        if namecallHooked and oldNamecall and type(hookmetamethod) == "function" then
                pcall(hookmetamethod, game, "__namecall", oldNamecall)
        end
        namecallHooked = false
        if origRaycastFn and type(hookfunction) == "function" then
                pcall(function()
                        hookfunction(Workspace.Raycast, origRaycastFn)
                end)
                origRaycastFn = nil
        end
        saHooksInstalled = false
end

local function saCanaryTest()
        return pcall(function()
                local a = workspace:GetFullName()
                local b = game:GetService("Players")
                return a ~= nil and b ~= nil
        end)
end

function saInstallHooks()
        if saHooksInstalled or not saRunToken or not silentAimSupported then
                return silentAimSupported
        end
        local okInstall = pcall(function()
                oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                        if internalRayActive or not saRunToken or not State.SilentAim then
                                return oldNamecall(self, ...)
                        end
                        local method = getnamecallmethod()
                        if method == "Raycast" then
                                if saRayChannelActive() then
                                        local origin, direction = ...
                                        local newDir = computeRedirect(origin, direction)
                                        if newDir then
                                                return oldNamecall(self, origin, newDir, select(3, ...))
                                        end
                                end
                        elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList"
                                or method == "FindPartOnRayWithWhitelist" then
                                if saRayChannelActive() then
                                        local ray = ...
                                        if typeof(ray) == "Ray" then
                                                local newDir = computeRedirect(ray.Origin, ray.Direction)
                                                if newDir then
                                                        local newRay = Ray.new(ray.Origin, newDir)
                                                        if method == "FindPartOnRay" then
                                                                return oldNamecall(self, newRay, select(2, ...))
                                                        end
                                                        local packed = table.pack(...)
                                                        packed[1] = newRay
                                                        return oldNamecall(self, table.unpack(packed, 1, packed.n))
                                                end
                                        end
                                end
                        elseif saCamChannelActive() and (method == "ViewportPointToRay"
                                or method == "ScreenPointToRay") then
                                local okCall, ray = pcall(oldNamecall, self, ...)
                                if okCall and typeof(ray) == "Ray" then
                                        local newDir = computeRedirect(ray.Origin, ray.Direction)
                                        if newDir then return Ray.new(ray.Origin, newDir) end
                                        return ray
                                end
                                return oldNamecall(self, ...)
                        end
                        return oldNamecall(self, ...)
                end))
                namecallHooked = true
        end)

        if okInstall and type(hookfunction) == "function" and State.SilentAimMode == "Raycast" then
                pcall(function()
                        origRaycastFn = hookfunction(Workspace.Raycast, function(self, origin, direction, params)
                                if State.SilentAimMode ~= "Raycast" then
                                        return origRaycastFn(self, origin, direction, params)
                                end
                                local newDir = computeRedirect(origin, direction)
                                if newDir then
                                        return origRaycastFn(self, origin, newDir, params)
                                end
                                return origRaycastFn(self, origin, direction, params)
                        end)
                end)
        end

        if not okInstall or not saCanaryTest() then
                saUninstallHooks()
                silentAimSupported = false
                State.SilentAim = false
                setSnyxStatus("Silent Aim ปิดให้อัตโนมัติ — hook ใช้งานไม่ได้")
                return false
        end
        saHooksInstalled = true
        setSnyxStatus("Silent Aim hook พร้อม (" .. tostring(State.SilentAimMode) .. ")")
        return true
end

function saReinstallHooks()
        if not silentAimSupported or not saRunToken or not State.SilentAim then return false end
        saUninstallHooks()
        return saInstallHooks()
end

CleanupManager:AddCustomCleanup(function()
        saRunToken = false
        silentTargetPlayer, silentTargetPart = nil, nil
        saUninstallHooks()
        if mouseHookInstalled and oldIndexHook and type(hookmetamethod) == "function" then
                pcall(hookmetamethod, game, "__index", oldIndexHook)
                mouseHookInstalled = false
                oldIndexHook = nil
        end
        origRaycastFn = nil
end)

local saAccumulator = 0
local SA_REFRESH_INTERVAL = 1 / 30

function refreshSilentTarget()
        silentTargetPlayer, silentTargetPart = nil, nil
        saVisPlayer, saVisOk = nil, false
        if not State.SilentAim or not saRunToken or not silentAimSupported then return end

        local locked = TargetService.CurrentTarget
        local lockedPart = TargetService.TargetPart
        if locked and lockedPart and lockedPart.Parent and isValidEnemy(locked) then
                silentTargetPlayer = locked
                silentTargetPart = lockedPart
                saVisPlayer = locked
                saVisAt = os.clock()
                if State.SilentAimWallCheck == false then
                        saVisOk = true
                elseif locked.Character then
                        saVisOk = VisibilityService:CheckVisibility(locked.Character, 1, lockedPart) == true
                else
                        saVisOk = false
                end
                return
        end

        local camera = getCamera()
        if not camera then return end
        local vp = camera.ViewportSize
        local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
        local maxDist = (State.SilentAimFOV or 120) * (vp.Y / 1080)
        local bestDist = maxDist
        local players = Players:GetPlayers()
        for i = 1, #players do
                local p = players[i]
                if isValidEnemy(p) then
                        local part = TargetService:GetTargetPart(p.Character)
                        if part then
                                local sp, onScreen = camera:WorldToViewportPoint(part.Position)
                                if onScreen and sp.Z > 0 then
                                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                        if d < bestDist then
                                                if State.SilentAimWallCheck == false
                                                        or VisibilityService:CheckVisibility(p.Character, 1, part) then
                                                        bestDist = d
                                                        silentTargetPlayer = p
                                                        silentTargetPart = part
                                                        saVisPlayer = p
                                                        saVisAt = os.clock()
                                                        saVisOk = true
                                                end
                                        end
                                end
                        end
                end
        end
end

CleanupManager:AddConn("SilentAimRefresh", RunService.Heartbeat:Connect(function(dt)
        if not State.SilentAim then
                if silentTargetPlayer or silentTargetPart then
                        silentTargetPlayer, silentTargetPart = nil, nil
                end
                return
        end
        saAccumulator += dt
        if saAccumulator >= SA_REFRESH_INTERVAL then
                saAccumulator = 0
                refreshSilentTarget()
        end
end))

if State.SilentAim and silentAimSupported then
        pcall(saInstallHooks)
end

print(("[SNYX v3.2] profile=%s | silentAimSupported=%s | silentAim=%s | mode=%s"):format(
        GAME_PROFILE, tostring(silentAimSupported), tostring(State.SilentAim), tostring(State.SilentAimMode)))

local flickUntil = 0
local prevReadLook = nil
local lastWriteLook = nil
local FLICK_HOLD = 0.10
local STEER_DPS = 45
local STEER_HOLD = 0.22
local STEER_MIN_INFLUENCE = 0.15
local STEER_TAU = 0.07
local SWITCH_EASE_SPEED = 30
local SWITCH_EASE_TIME = 0.15
local SWITCH_EASE_MIN_ERR = 3

local steerInfluence = 1
local steerHoldStart = nil
local switchEaseUntil = 0
local prevAimKey = nil
local prevErrDeg = nil

CleanupManager:AddConn("RenderStep", RunService.RenderStepped:Connect(function(deltaTime)
        local camera = getCamera()
        if not camera then return end

        local userLook = camera.CFrame.LookVector
        local dtSafe = math.max(deltaTime, 1e-4)
        frameDtEMA += (dtSafe - frameDtEMA) * 0.08
        local userDps = math.huge
        if prevReadLook then
                local uDot = math.clamp(userLook:Dot(prevReadLook), -1, 1)
                local uDeg = math.deg(math.acos(uDot))
                if uDeg > 0.05 then userDps = uDeg / dtSafe end
        end
        if lastWriteLook then
                local wDot = math.clamp(userLook:Dot(lastWriteLook), -1, 1)
                local wDeg = math.deg(math.acos(wDot))
                if wDeg > 0.05 and wDeg / dtSafe < userDps then
                        userDps = wDeg / dtSafe
                end
        end
        if userDps == math.huge then userDps = 0 end
        prevReadLook = userLook
        lastWriteLook = nil

        if State.DragSwitch and userDps > (State.FlickSpeed or 140) then
                flickUntil = os.clock() + FLICK_HOLD
        end

        local zoomRaw = getZoomScale(camera)
        if not zoomSmoothed then
                zoomSmoothed = zoomRaw
        else
                zoomSmoothed += (zoomRaw - zoomSmoothed) * (1 - math.exp(-deltaTime / ZOOM_TAU))
        end

        local vp = camera.ViewportSize
        local screenCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
        local scaledFOV = State.FOV * (vp.Y / 1080)

        if State.ShowFOV then
                FOVCircle.Position = screenCenter
                FOVCircle.Radius = scaledFOV
                FOVCircle.Visible = true
        elseif FOVCircle.Visible then
                FOVCircle.Visible = false
        end

        if not State.Aimbot or not hasActiveWeapon() then
                if TargetService.CurrentTarget then TargetService:ReleaseTarget() end
                prevErrDeg = nil
                steerInfluence = 1
                steerHoldStart = nil
                prevAimKey = nil
                runTriggerBot(camera, false)
                return
        end

        if State.DragSwitch and os.clock() < flickUntil then
                if TargetService.CurrentTarget then
                        switchAwayKey = TargetService.CurrentTarget
                        switchCooldownUntil = os.clock() + SWITCH_COOLDOWN
                        TargetService:ReleaseTarget()
                end
                steerInfluence = 1
                steerHoldStart = nil
                prevErrDeg = nil
                prevAimKey = nil
                triggerReset()
                return
        end

        if switchAwayKey and os.clock() >= switchCooldownUntil then
                switchAwayKey = nil
        end

        if TargetService.CurrentTarget then
                if not isValidEnemy(TargetService.CurrentTarget) then
                        TargetService:ReleaseTarget()
                elseif TargetService:KeepTarget(camera, screenCenter, scaledFOV) then
                        targetGraceUntil = 0
                else
                        if targetGraceUntil == 0 then
                                targetGraceUntil = os.clock() + TARGET_GRACE
                        end
                        local part = TargetService.TargetPart
                        local onScreen = false
                        if part then
                                local sp, isOn = camera:WorldToViewportPoint(part.Position)
                                onScreen = isOn and sp.Z > 0
                        end
                        if not onScreen or os.clock() >= targetGraceUntil then
                                TargetService:ReleaseTarget()
                        end
                end
        end

        if not TargetService.CurrentTarget then
                TargetService:AcquireTarget(camera, screenCenter, scaledFOV)
        end

        if TargetService.CurrentTarget then
                if TargetService.CurrentTarget ~= prevAimKey then
                        switchEaseUntil = os.clock() + SWITCH_EASE_TIME
                end
                prevAimKey = TargetService.CurrentTarget
        else
                prevAimKey = nil
        end

        local targetPart = TargetService.TargetPart
        if TargetService.CurrentTarget and targetPart and targetPart.Parent then
                local shooterPos = camera.CFrame.Position
                local zoomScale = zoomSmoothed
                local baseSpeed = math.clamp(State.Smoothness * 120 * zoomScale, 6, 440)
                local leadTau = State.LagComp and math.min(1 / baseSpeed, 0.15) or 0
                local targetPos = getPredictedPosition(targetPart, shooterPos, deltaTime, leadTau, zoomScale)

                local desiredDirection = safeUnit(targetPos - shooterPos)
                if desiredDirection then
                        local dot = math.clamp(camera.CFrame.LookVector:Dot(desiredDirection), -1, 1)
                        local errDeg = math.deg(math.acos(dot))
                        local snapAngle = State.SnapAngle or 20
                        local errScaled = errDeg * zoomScale
                        local boostC = State.TrackBoost or 1.5
                        local boost = 1 + math.min(errScaled / 10, 2) * boostC
                        local effSpeed = math.min(baseSpeed * boost, 560)
                        local sdt = math.min(deltaTime, 1 / 30)
                        local normalAlpha = 1 - math.exp(-effSpeed * sdt)
                        local alpha = normalAlpha
                        if snapAngle > 0 then
                                local snapBlend = math.clamp((errScaled - snapAngle * 0.35) / (snapAngle * 0.5), 0, 1)
                                alpha = normalAlpha + (1 - normalAlpha) * snapBlend * math.sqrt(snapBlend)
                        end
                        if os.clock() < switchEaseUntil and errScaled > SWITCH_EASE_MIN_ERR then
                                alpha = math.min(alpha, 1 - math.exp(-SWITCH_EASE_SPEED * sdt))
                        end

                        local steering = State.FreeSteer and userDps > STEER_DPS
                                and prevErrDeg ~= nil and errDeg > prevErrDeg + 0.05
                        if steering then
                                if not steerHoldStart then steerHoldStart = os.clock() end
                                if State.DragSwitch and os.clock() - steerHoldStart >= STEER_HOLD then
                                        switchAwayKey = TargetService.CurrentTarget
                                        switchCooldownUntil = os.clock() + SWITCH_COOLDOWN
                                        TargetService:ReleaseTarget()
                                        flickUntil = os.clock() + FLICK_HOLD
                                        prevAimKey = nil
                                        triggerReset()
                                        return
                                end
                        else
                                steerHoldStart = nil
                        end
                        local infTarget = steering and STEER_MIN_INFLUENCE or 1
                        steerInfluence += (infTarget - steerInfluence) * (1 - math.exp(-deltaTime / STEER_TAU))

                        alpha = math.clamp(alpha, 0, 1)
                        steerInfluence = math.clamp(steerInfluence, 0, 1)
                        local smoothDirection = safeUnit(camera.CFrame.LookVector:Lerp(desiredDirection, alpha * steerInfluence))
                        if smoothDirection then
                                local ok, newCFrame = pcall(CFrame.lookAt, shooterPos, shooterPos + smoothDirection)
                                if ok and newCFrame then
                                        camera.CFrame = newCFrame
                                        lastWriteLook = smoothDirection
                                end
                        end
                        prevErrDeg = errDeg
                end
        end

        local aimBusy = os.clock() < flickUntil or os.clock() < switchEaseUntil
        runTriggerBot(camera, aimBusy)
end))

if State.SilentAim then
